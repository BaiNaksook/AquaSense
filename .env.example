# Supabase (บันทึกค่าระดับน้ำ / ประวัติแจ้งเตือน)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# MQTT (HiveMQ Cloud) — ควรใช้บัญชีที่ subscribe ได้อย่างเดียว เพราะค่านี้ผู้ใช้เปิดดูได้จากเบราว์เซอร์
VITE_MQTT_URL=wss://your-cluster.s1.eu.hivemq.cloud:8884/mqtt
VITE_MQTT_USERNAME=dashboard-readonly
VITE_MQTT_PASSWORD=change-me
VITE_MQTT_TOPIC=aquasense/sensor/distance

# สถานี / พิกัดสำหรับพยากรณ์อากาศ (ค่าเริ่มต้น: นาเกลือ ต.นาโคก สมุทรสาคร)
VITE_STATION_NAME=นาเกลือ แปลงที่ 1
VITE_STATION_LAT=13.47
VITE_STATION_LON=100.20

# (ไม่บังคับ) token API กรมอุตุนิยมวิทยา https://data.tmd.go.th/nwpapi — ไม่ใส่ก็ใช้ Open-Meteo อย่างเดียว
VITE_TMD_TOKEN=
